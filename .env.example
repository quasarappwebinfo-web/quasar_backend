# --- App ---
APP_NAME=Quasar Backend
ENVIRONMENT=local
DEBUG=true

# Puerto donde escucha Uvicorn DENTRO del contenedor y en local
API_PORT=8002

# --- Base de datos MySQL 8 ---
DATABASE_URL=mysql+pymysql://root:${MYSQL_ROOT_PASSWORD}@db:3306/${MYSQL_DATABASE}
# Puerto MySQL en el HOST (cambia si choca con otro proyecto, ej. 3307/3308)
DB_HOST_PORT=3309

MYSQL_ROOT_PASSWORD=cambiar_en_desarrollo
MYSQL_DATABASE=quasar_db

# --- Seguridad JWT ---
SECRET_KEY=cambiar-en-produccion-usa-openssl-rand-hex-32
ALGORITHM=HS256
# Access corto (minutos). La sesión larga va en refresh cookie HttpOnly.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=quasar_backend
JWT_AUDIENCE=quasar_frontend

# Cookie de refresh (ver docs/auth-frontend.md)
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# false en HTTP local; true en HTTPS (staging/prod)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- CORS (coma-separado; debe incluir el origen exacto del frontend) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- AWS S3 (medios: fotos, documentos) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=
S3_USE_PRESIGNED_URLS=true
S3_PRESIGN_EXPIRE_SECONDS=86400

# COMPOSE_PROJECT_NAME=quasar_backend_dev
